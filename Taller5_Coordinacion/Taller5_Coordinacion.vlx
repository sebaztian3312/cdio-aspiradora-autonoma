{"format":"velxio-project","version":1,"name":"Taller5_Coordinacion","boards":[{"id":"esp32","boardKind":"esp32","x":20,"y":70,"activeFileGroupId":"group-esp32","languageMode":"arduino","serialBaudRate":115200}],"fileGroups":{"group-esp32":[{"name":"sketch.ino","content":"// Taller 5 - Coordinacion de entradas y salidas (ESP32, arduino-esp32 3.x)\n// Maquina de estados sin delay(): REPOSO, ACTIVO, PAUSA y ALERTA_BATERIA.\n// El potenciometro representa la bateria, el pulsador es el boton de arranque y los\n// LED son los indicadores. Integra los ultrasonicos (Taller 4), los motores (Taller 3)\n// y el bumper por interrupcion.\n// Comandos por el monitor serie:\n//   d -> alterna la version con delay(200), solo para comparar (procedimiento 4)\n//   s -> activa o desactiva los sensores y los motores (reto 5)\n//   m -> compara la respuesta al bumper con sondeo y con interrupcion (reto 7)\n\n// ---------------- pines ----------------\nconst int BOTON = 27, BUMPER = 33;               // entradas con pull-up interna\nconst int BAT = 34;                              // potenciometro que representa la bateria\nconst int LED1 = 26, LED2 = 13;                  // LED 1: estado, LED 2: bateria\nconst int TRIG_F = 32, ECHO_F = 35, TRIG_L = 22, ECHO_L = 36;   // ultrasonicos\nconst int ENA = 19, IN1 = 18, IN2 = 17;          // motor izquierdo\nconst int ENB = 16, IN3 = 4, IN4 = 21;           // motor derecho\nconst int PRUEBA = 23;                           // unido al bumper: simula choques (reto 7)\n\n// ---------------- parametros ----------------\nconst int ADC_AVISO = 2286;                      // aviso del reto 6 del Taller 2: enciende el LED 2\nconst int ADC_CORTE = 1000;                      // por debajo: entra a ALERTA_BATERIA\nconst int ADC_SALIDA = 1200;                     // por encima: sale de ALERTA_BATERIA (histeresis)\nconst unsigned long T_PARPADEO = 500;            // 500 ms encendido + 500 ms apagado = 1 Hz\nconst unsigned long T_REBOTE = 50;               // ms que el pulsador debe estar estable\nconst unsigned long T_SENSOR = 60;               // ms entre disparos de los ultrasonicos\nconst unsigned long TIMEOUT_ECO = 12000;         // us: espera maxima del eco (~2 m)\nconst float D_PARAR = 20.0, D_SEGUIR = 25.0;     // cm: se detiene y vuelve a avanzar\nconst int VEL = 180;                             // ciclo util de avance (0 a 255)\n\nenum Estado { REPOSO, ACTIVO, PAUSA, ALERTA_BATERIA };\nconst char* NOMBRE[] = {\"REPOSO\", \"ACTIVO\", \"PAUSA\", \"ALERTA_BATERIA\"};\nEstado estado = REPOSO;\n\n// ---------------- variables ----------------\nvolatile bool choque = false;                    // la escribe la interrupcion del bumper\nvolatile bool sondeoPendiente = false;           // el sondeo aun no ha visto el ultimo choque\nvolatile unsigned long tChoque = 0;              // micros() en el instante del choque\n\nint adcBat = 4095;\nfloat distF = 999, distL = 999;\nbool obstaculo = false, sensores = true, conDelay = false, led1 = false;\nunsigned long tParpadeo = 0, tSensor = 0;\nbool turnoFrontal = true;\nchar txt[48];\n\n// medicion del tiempo de ciclo (procedimiento 4)\nunsigned long tLoopAnterior = 0, peorCiclo = 0, tVentana = 0;\n\n// comparacion sondeo contra interrupcion (reto 7)\nconst int N_PRUEBAS = 20;                        // choques simulados por medicion\nbool midiendo = false, lineaAbajo = false;\nint pruebasHechas = 0, vistosSondeo = 0;\nunsigned long tPrueba = 0, peorSondeo = 0, sumaSondeo = 0;\n\n// ---------------- interrupcion ----------------\nvoid IRAM_ATTR isrBumper() {                     // corta: solo guarda el instante y avisa\n  if (!choque) { tChoque = micros(); choque = true; sondeoPendiente = true; }\n}\n\n// ---------------- registro de transiciones ----------------\nvoid registrar(const char* evento) {\n  Serial.printf(\"%7lu ms | %-14s | %s\\n\", millis(), NOMBRE[estado], evento);\n}\nvoid cambiar(Estado nuevo, const char* evento) {\n  Serial.printf(\"%7lu ms | %-14s -> %-14s | %s\\n\", millis(), NOMBRE[estado], NOMBRE[nuevo], evento);\n  estado = nuevo;\n  tParpadeo = millis();\n}\n\n// ---------------- actuadores ----------------\nvoid motores(int duty) {                         // duty > 0 avanza, 0 detiene\n  digitalWrite(IN1, duty > 0); digitalWrite(IN2, LOW);\n  digitalWrite(IN3, duty > 0); digitalWrite(IN4, LOW);\n  ledcWrite(ENA, duty); ledcWrite(ENB, duty);\n}\n\n// ---------------- entradas ----------------\n// antirrebote sin bloqueo: devuelve true una sola vez por pulsacion\nbool leerPulsacion() {\n  static int estable = HIGH, anterior = HIGH;\n  static unsigned long tCambio = 0;\n  int lectura = digitalRead(BOTON);\n  if (lectura != anterior) { anterior = lectura; tCambio = millis(); }\n  if (millis() - tCambio >= T_REBOTE && lectura != estable) {\n    estable = lectura;\n    if (estable == LOW) return true;             // pulsacion validada\n  }\n  return false;\n}\n\nfloat medir(int trig, int echo) {\n  digitalWrite(trig, LOW);  delayMicroseconds(2);\n  digitalWrite(trig, HIGH); delayMicroseconds(10);\n  digitalWrite(trig, LOW);\n  unsigned long t = pulseIn(echo, HIGH, TIMEOUT_ECO);\n  if (t == 0) return 999;                        // sin eco: nada al frente\n  return t / 58.0;\n}\n\n// los dos ultrasonicos se disparan por turnos cada 60 ms (Taller 4, reto 4)\nvoid leerSensores() {\n  if (!sensores || millis() - tSensor < T_SENSOR) return;\n  tSensor = millis();\n  if (turnoFrontal) distF = medir(TRIG_F, ECHO_F);\n  else              distL = medir(TRIG_L, ECHO_L);\n  turnoFrontal = !turnoFrontal;\n}\n\n// ---------------- comandos por serie ----------------\nvoid comandos() {\n  if (!Serial.available()) return;\n  char c = Serial.read();\n  if (c == 'd') {\n    conDelay = !conDelay;\n    peorCiclo = 0; tVentana = millis();\n    Serial.printf(\"Version con delay(200): %s\\n\", conDelay ? \"SI\" : \"NO\");\n  } else if (c == 's') {\n    sensores = !sensores;\n    peorCiclo = 0; tVentana = millis();\n    Serial.printf(\"Sensores y motores: %s\\n\", sensores ? \"ACTIVADOS\" : \"DESACTIVADOS\");\n  } else if (c == 'm') {\n    midiendo = true; lineaAbajo = false; sondeoPendiente = false;\n    pruebasHechas = 0; vistosSondeo = 0; peorSondeo = 0; sumaSondeo = 0; tPrueba = millis();\n  }\n}\n\n// ---------------- reto 7: sondeo contra interrupcion ----------------\n// La interrupcion guarda el instante exacto del choque. El sondeo revisa el pin una vez\n// por vuelta del loop; la diferencia entre los dos es lo que tarda el sondeo en enterarse.\nvoid reto7() {\n  if (!midiendo) return;\n  if (sondeoPendiente && digitalRead(BUMPER) == LOW) {       // sondeo: una lectura por vuelta\n    sondeoPendiente = false;\n    unsigned long retraso = micros() - tChoque;\n    sumaSondeo += retraso; vistosSondeo++;\n    if (retraso > peorSondeo) peorSondeo = retraso;\n  }\n  unsigned long t = millis();\n  if (!lineaAbajo && t - tPrueba >= 150) {                   // nuevo choque simulado\n    if (pruebasHechas == N_PRUEBAS) {\n      Serial.printf(\"%7lu ms | reto 7 | %d choques, sensores: %s\\n\",\n                    millis(), N_PRUEBAS, sensores ? \"SI\" : \"NO\");\n      Serial.printf(\"          interrupcion: registra el choque en el instante del flanco\\n\");\n      Serial.printf(\"          sondeo: lo ve %lu us despues en promedio y %lu us en el peor caso\\n\",\n                    sumaSondeo / max(vistosSondeo, 1), peorSondeo);\n      midiendo = false;\n      return;\n    }\n    pinMode(PRUEBA, OUTPUT); digitalWrite(PRUEBA, LOW);      // baja la linea del bumper\n    lineaAbajo = true; tPrueba = t; pruebasHechas++;\n  } else if (lineaAbajo && t - tPrueba >= 100) {             // la suelta a los 100 ms\n    pinMode(PRUEBA, INPUT);\n    lineaAbajo = false; tPrueba = t;\n  }\n}\n\n// ---------------- programa principal ----------------\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(BOTON, INPUT_PULLUP);\n  pinMode(BUMPER, INPUT_PULLUP);\n  pinMode(PRUEBA, INPUT);                        // alta impedancia: no afecta al bumper\n  pinMode(LED1, OUTPUT); pinMode(LED2, OUTPUT);\n  pinMode(TRIG_F, OUTPUT); pinMode(TRIG_L, OUTPUT);\n  pinMode(ECHO_F, INPUT);  pinMode(ECHO_L, INPUT);\n  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT); pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);\n  ledcAttach(ENA, 20000, 8);\n  ledcAttach(ENB, 20000, 8);\n  motores(0);\n  attachInterrupt(digitalPinToInterrupt(BUMPER), isrBumper, FALLING);\n  Serial.println(\"Taller 5 - comandos: d = version con delay, s = sensores, m = medir bumper\");\n  registrar(\"encendido\");\n  tVentana = millis();\n}\n\nvoid loop() {\n  // procedimiento 4: tiempo entre dos vueltas del loop y peor caso en 30 s\n  unsigned long ahoraUs = micros();\n  unsigned long ciclo = ahoraUs - tLoopAnterior;\n  if (tLoopAnterior != 0 && ciclo > peorCiclo) peorCiclo = ciclo;\n  tLoopAnterior = ahoraUs;\n  if (millis() - tVentana >= 30000) {\n    Serial.printf(\"%7lu ms | peor ciclo del loop en 30 s: %lu us (delay: %s, sensores: %s)\\n\",\n                  millis(), peorCiclo, conDelay ? \"SI\" : \"NO\", sensores ? \"SI\" : \"NO\");\n    peorCiclo = 0; tVentana = millis();\n  }\n\n  reto7();                                       // solo actua despues del comando m\n\n  // 1) prioridad: bateria, evaluada antes que cualquier otro evento (reto 3)\n  adcBat = analogRead(BAT);\n  if (estado != ALERTA_BATERIA && adcBat < ADC_CORTE) {\n    motores(0);\n    snprintf(txt, sizeof txt, \"bateria baja: %d cuentas\", adcBat);\n    cambiar(ALERTA_BATERIA, txt);\n  } else if (estado == ALERTA_BATERIA && adcBat > ADC_SALIDA) {   // histeresis (reto 4)\n    snprintf(txt, sizeof txt, \"bateria recuperada: %d cuentas\", adcBat);\n    cambiar(REPOSO, txt);\n  }\n\n  // 2) bumper atendido por interrupcion (reto 6)\n  if (choque) {\n    choque = false;\n    if (!midiendo) {                             // los choques simulados del reto 7 no cuentan\n      if (estado == ACTIVO) { motores(0); cambiar(PAUSA, \"choque del bumper\"); }\n      else registrar(\"choque del bumper\");\n    }\n  }\n\n  // 3) pulsador con antirrebote (reto 2)\n  if (leerPulsacion()) {\n    if (estado == REPOSO)      cambiar(ACTIVO, \"pulsacion\");\n    else if (estado == ACTIVO) cambiar(PAUSA, \"pulsacion\");\n    else if (estado == PAUSA)  cambiar(ACTIVO, \"pulsacion\");\n    else registrar(\"pulsacion ignorada: bateria baja\");   // el pulsador no saca de la alerta\n  }\n\n  // 4) sensores y motores (reto 5): un obstaculo detiene los motores, el LED sigue\n  leerSensores();\n  if (estado == ACTIVO && sensores) {\n    float d = min(distF, distL);\n    if (!obstaculo && d < D_PARAR) {\n      obstaculo = true;\n      snprintf(txt, sizeof txt, \"obstaculo a %.1f cm: motores detenidos\", d);\n      registrar(txt);\n    } else if (obstaculo && d > D_SEGUIR) {\n      obstaculo = false;\n      registrar(\"camino libre: motores en marcha\");\n    }\n    motores(obstaculo ? 0 : VEL);\n  } else {\n    motores(0);\n  }\n\n  // 5) salidas de cada estado\n  switch (estado) {\n    case REPOSO:         digitalWrite(LED1, LOW);  break;\n    case PAUSA:          digitalWrite(LED1, HIGH); break;\n    case ALERTA_BATERIA: digitalWrite(LED1, LOW);  break;\n    case ACTIVO:                                  // parpadeo a 1 Hz con millis()\n      if (millis() - tParpadeo >= T_PARPADEO) {\n        tParpadeo = millis();\n        led1 = !led1;\n        digitalWrite(LED1, led1);\n      }\n      break;\n  }\n  digitalWrite(LED2, estado == ALERTA_BATERIA || adcBat < ADC_AVISO);\n\n  comandos();\n  if (conDelay) delay(200);                      // solo para la comparacion del procedimiento 4\n}\n"}]},"components":[{"id":"drv","metadataId":"motor-driver-l293d","x":330,"y":163,"properties":{}},{"id":"psu","metadataId":"power-supply","x":470,"y":330,"properties":{"mode":"dc","voltage":6,"frequency":50,"currentLimit":1}},{"id":"mIzq","metadataId":"pro-dc-motor","x":230,"y":285,"properties":{}},{"id":"mDer","metadataId":"pro-dc-motor","x":480,"y":150,"properties":{}},{"id":"usL","metadataId":"hc-sr04","x":-290,"y":-110,"properties":{"distance":"60"}},{"id":"potBat","metadataId":"potentiometer","x":-390,"y":-90,"properties":{"value":600}},{"id":"usF","metadataId":"hc-sr04","x":-590,"y":-110,"properties":{"distance":"100"}},{"id":"bumper","metadataId":"pushbutton","x":-700,"y":-70,"properties":{"color":"black"}},{"id":"ledR","metadataId":"led","x":-70,"y":360,"properties":{"color":"red"}},{"id":"rR","metadataId":"resistor","x":-90,"y":440,"properties":{"value":"220"}},{"id":"btn","metadataId":"pushbutton","x":-300,"y":360,"properties":{"color":"green"}},{"id":"ledV","metadataId":"led","x":-400,"y":360,"properties":{"color":"green"}},{"id":"rV","metadataId":"resistor","x":-420,"y":440,"properties":{"value":"220"}}],"wires":[{"id":"c1","start":{"componentId":"esp32","pinName":"19","x":154,"y":163},"end":{"componentId":"drv","pinName":"EN1","x":336,"y":181},"waypoints":[{"x":240,"y":163},{"x":240,"y":181}],"color":"#e67e22"},{"id":"c2","start":{"componentId":"esp32","pinName":"18","x":154,"y":175},"end":{"componentId":"drv","pinName":"IN1","x":336,"y":189},"waypoints":[{"x":230,"y":175},{"x":230,"y":189}],"color":"#f1c40f"},{"id":"c3","start":{"componentId":"esp32","pinName":"17","x":154,"y":201},"end":{"componentId":"drv","pinName":"IN2","x":336,"y":229},"waypoints":[{"x":220,"y":201},{"x":220,"y":229}],"color":"#f1c40f"},{"id":"c4","start":{"componentId":"esp32","pinName":"21","x":154,"y":150},"end":{"componentId":"drv","pinName":"IN4","x":436,"y":189},"waypoints":[{"x":180,"y":150},{"x":180,"y":130},{"x":455,"y":130},{"x":455,"y":189}],"color":"#9b59b6"},{"id":"c5","start":{"componentId":"esp32","pinName":"16","x":154,"y":213},"end":{"componentId":"drv","pinName":"EN2","x":436,"y":237},"waypoints":[{"x":205,"y":213},{"x":205,"y":262},{"x":455,"y":262},{"x":455,"y":237}],"color":"#8e44ad"},{"id":"c6","start":{"componentId":"esp32","pinName":"4","x":154,"y":226},"end":{"componentId":"drv","pinName":"IN3","x":436,"y":229},"waypoints":[{"x":195,"y":226},{"x":195,"y":272},{"x":465,"y":272},{"x":465,"y":229}],"color":"#9b59b6"},{"id":"p1","start":{"componentId":"psu","pinName":"SIG","x":556,"y":360},"end":{"componentId":"drv","pinName":"VCC2","x":336,"y":237},"waypoints":[{"x":590,"y":354},{"x":590,"y":290},{"x":322,"y":290},{"x":322,"y":237}],"color":"#e74c3c"},{"id":"p2","start":{"componentId":"psu","pinName":"SIG","x":556,"y":360},"end":{"componentId":"drv","pinName":"VCC1","x":436,"y":181},"waypoints":[{"x":600,"y":360},{"x":600,"y":115},{"x":445,"y":115},{"x":445,"y":181}],"color":"#e74c3c"},{"id":"g1","start":{"componentId":"psu","pinName":"GND","x":556,"y":384},"end":{"componentId":"esp32","pinName":"GND2","x":154,"y":264},"waypoints":[{"x":580,"y":384},{"x":580,"y":445},{"x":170,"y":445},{"x":170,"y":264}],"color":"#2c3e50"},{"id":"g2","start":{"componentId":"drv","pinName":"GND.1","x":336,"y":205},"end":{"componentId":"esp32","pinName":"GND2","x":154,"y":264},"waypoints":[{"x":325,"y":205},{"x":325,"y":250},{"x":175,"y":250},{"x":175,"y":264}],"color":"#2c3e50"},{"id":"g3","start":{"componentId":"drv","pinName":"GND.4","x":436,"y":205},"end":{"componentId":"drv","pinName":"GND.1","x":336,"y":205},"waypoints":[{"x":440,"y":205},{"x":440,"y":155},{"x":335,"y":155}],"color":"#2c3e50"},{"id":"o1","start":{"componentId":"drv","pinName":"OUT1","x":336,"y":197},"end":{"componentId":"mIzq","pinName":"+","x":268,"y":304.6},"waypoints":[{"x":310,"y":197},{"x":310,"y":272},{"x":268,"y":272}],"color":"#27ae60"},{"id":"o2","start":{"componentId":"drv","pinName":"OUT2","x":336,"y":221},"end":{"componentId":"mIzq","pinName":"-","x":300,"y":304.6},"waypoints":[{"x":316,"y":221},{"x":316,"y":284},{"x":300,"y":284}],"color":"#c0392b"},{"id":"o3","start":{"componentId":"drv","pinName":"OUT3","x":436,"y":221},"end":{"componentId":"mDer","pinName":"+","x":518,"y":169.6},"waypoints":[{"x":490,"y":221},{"x":490,"y":178},{"x":518,"y":178}],"color":"#27ae60"},{"id":"o4","start":{"componentId":"drv","pinName":"OUT4","x":436,"y":197},"end":{"componentId":"mDer","pinName":"-","x":550,"y":169.6},"waypoints":[{"x":470,"y":197},{"x":470,"y":140},{"x":550,"y":140}],"color":"#c0392b"},{"id":"s2","start":{"componentId":"usL","pinName":"ECHO","x":-192.7,"y":-9.5},"end":{"componentId":"esp32","pinName":"VP","x":26,"y":124},"waypoints":[{"x":-192.7,"y":124}],"color":"#1abc9c"},{"id":"s3","start":{"componentId":"potBat","pinName":"SIG","x":-345,"y":-15.5},"end":{"componentId":"esp32","pinName":"34","x":26,"y":137},"waypoints":[{"x":-345,"y":137}],"color":"#e67e22"},{"id":"s4","start":{"componentId":"usF","pinName":"ECHO","x":-492.7,"y":-9.5},"end":{"componentId":"esp32","pinName":"35","x":26,"y":150},"waypoints":[{"x":-492.7,"y":150}],"color":"#1abc9c"},{"id":"s5","start":{"componentId":"usF","pinName":"TRIG","x":-502.7,"y":-9.5},"end":{"componentId":"esp32","pinName":"32","x":26,"y":163},"waypoints":[{"x":-502.7,"y":163}],"color":"#16a085"},{"id":"s6","start":{"componentId":"bumper","pinName":"1.r","x":-627,"y":-51},"end":{"componentId":"esp32","pinName":"33","x":26,"y":175},"waypoints":[{"x":-610,"y":-51},{"x":-610,"y":175}],"color":"#7f8c8d"},{"id":"s7","start":{"componentId":"usL","pinName":"TRIG","x":-202.7,"y":-9.5},"end":{"componentId":"esp32","pinName":"22","x":154,"y":112},"waypoints":[{"x":-202.7,"y":50},{"x":250,"y":50},{"x":250,"y":112}],"color":"#16a085"},{"id":"s9","start":{"componentId":"esp32","pinName":"23","x":154,"y":99},"end":{"componentId":"bumper","pinName":"1.r","x":-627,"y":-51},"waypoints":[{"x":200,"y":99},{"x":200,"y":-95},{"x":-610,"y":-95},{"x":-610,"y":-51}],"color":"#d35400"},{"id":"gt1","start":{"componentId":"usF","pinName":"GND","x":-482.7,"y":-9.5},"end":{"componentId":"potBat","pinName":"GND","x":-355,"y":-15.5},"waypoints":[{"x":-482.7,"y":20},{"x":-355,"y":20}],"color":"#2c3e50"},{"id":"gt2","start":{"componentId":"potBat","pinName":"GND","x":-355,"y":-15.5},"end":{"componentId":"usL","pinName":"GND","x":-182.7,"y":-9.5},"waypoints":[{"x":-355,"y":20},{"x":-182.7,"y":20}],"color":"#2c3e50"},{"id":"gt5","start":{"componentId":"bumper","pinName":"2.l","x":-694,"y":-32},"end":{"componentId":"usF","pinName":"GND","x":-482.7,"y":-9.5},"waypoints":[{"x":-720,"y":-32},{"x":-720,"y":20},{"x":-482.7,"y":20}],"color":"#2c3e50"},{"id":"vu1","start":{"componentId":"usF","pinName":"VCC","x":-512.7,"y":-9.5},"end":{"componentId":"usL","pinName":"VCC","x":-212.7,"y":-9.5},"waypoints":[{"x":-512.7,"y":30},{"x":-212.7,"y":30}],"color":"#e74c3c"},{"id":"vu2","start":{"componentId":"usF","pinName":"VCC","x":-512.7,"y":-9.5},"end":{"componentId":"esp32","pinName":"VIN","x":26,"y":277},"waypoints":[{"x":-512.7,"y":30},{"x":-740,"y":30},{"x":-740,"y":500},{"x":10,"y":500},{"x":10,"y":277}],"color":"#e74c3c"},{"id":"vp2","start":{"componentId":"potBat","pinName":"VCC","x":-335,"y":-15.5},"end":{"componentId":"esp32","pinName":"3V3","x":154,"y":277},"waypoints":[{"x":-335,"y":38},{"x":-760,"y":38},{"x":-760,"y":520},{"x":164,"y":520},{"x":164,"y":277}],"color":"#e67e22"},{"id":"b1","start":{"componentId":"ledR","pinName":"A","x":-39,"y":408},"end":{"componentId":"esp32","pinName":"13","x":26,"y":251},"waypoints":[{"x":-39,"y":418},{"x":-20,"y":418},{"x":-20,"y":251}],"color":"#e74c3c"},{"id":"b2","start":{"componentId":"ledR","pinName":"C","x":-49,"y":408},"end":{"componentId":"rR","pinName":"1","x":-84,"y":451.65},"waypoints":[{"x":-49,"y":428},{"x":-95,"y":428},{"x":-95,"y":451.65}],"color":"#2c3e50"},{"id":"b4","start":{"componentId":"btn","pinName":"1.r","x":-227,"y":379},"end":{"componentId":"esp32","pinName":"27","x":26,"y":213},"waypoints":[{"x":-210,"y":379},{"x":-210,"y":213}],"color":"#27ae60"},{"id":"b5","start":{"componentId":"ledV","pinName":"A","x":-369,"y":408},"end":{"componentId":"esp32","pinName":"26","x":26,"y":201},"waypoints":[{"x":-369,"y":418},{"x":-350,"y":418},{"x":-350,"y":201}],"color":"#27ae60"},{"id":"b6","start":{"componentId":"ledV","pinName":"C","x":-379,"y":408},"end":{"componentId":"rV","pinName":"1","x":-414,"y":451.65},"waypoints":[{"x":-379,"y":428},{"x":-425,"y":428},{"x":-425,"y":451.65}],"color":"#2c3e50"},{"id":"gb2","start":{"componentId":"rV","pinName":"2","x":-355.2,"y":451.65},"end":{"componentId":"btn","pinName":"2.l","x":-294,"y":398},"waypoints":[{"x":-355.2,"y":480},{"x":-310,"y":480},{"x":-310,"y":398}],"color":"#2c3e50"},{"id":"gb3","start":{"componentId":"btn","pinName":"2.l","x":-294,"y":398},"end":{"componentId":"rR","pinName":"2","x":-25.2,"y":451.65},"waypoints":[{"x":-310,"y":480},{"x":-25.2,"y":480}],"color":"#2c3e50"},{"id":"gb5","start":{"componentId":"rR","pinName":"2","x":-25.2,"y":451.65},"end":{"componentId":"esp32","pinName":"GND","x":26,"y":264},"waypoints":[{"x":-25.2,"y":480},{"x":0,"y":480},{"x":0,"y":264}],"color":"#2c3e50"},{"id":"gb6","start":{"componentId":"bumper","pinName":"2.l","x":-694,"y":-32},"end":{"componentId":"rV","pinName":"2","x":-355.2,"y":451.65},"waypoints":[{"x":-720,"y":-32},{"x":-720,"y":480},{"x":-355.2,"y":480}],"color":"#2c3e50"}],"activeBoardId":"esp32"}